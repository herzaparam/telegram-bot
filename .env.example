# Trade Agent environment variables template
# Copy to .env and fill in real values

# Database
DB_PASSWORD=trade_dev
DATABASE_URL=postgresql+asyncpg://trade:trade_dev@localhost:5432/trade_agent
DATABASE_URL_SYNC=postgresql://trade:trade_dev@localhost:5432/trade_agent

# LLM
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gemini/gemini-2.0-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram webhook
WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Phase 8: External API keys (optional)
FRED_API_KEY=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
