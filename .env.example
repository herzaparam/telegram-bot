# Database
DATABASE_URL=postgresql+asyncpg://trade:trade@localhost:5432/trade_agent
DATABASE_URL_SYNC=postgresql://trade:trade@localhost:5432/trade_agent

# LLM
OPENAI_API_KEY=sk-your-openai-key-here
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gemini/gemini-2.0-flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pipeline timeouts (seconds)
TIMEOUT_FETCH=60
TIMEOUT_ANALYZE=120
TIMEOUT_LLM=30
